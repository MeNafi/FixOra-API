model Category {
  id          String  @id @default(uuid())
  name        String  @unique @db.VarChar(120)
  slug        String  @unique @db.VarChar(140)
  description String?
  icon        String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[]

  @@map("categories")
}

