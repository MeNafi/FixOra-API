# ---------------- Server ----------------
PORT=5000
NODE_ENV=development

# Where your frontend runs. Used for CORS and for Stripe success/cancel redirects.
APP_URL=http://localhost:3000

# Where this API runs. Used when building callback URLs.
API_URL=http://localhost:5000

# ---------------- Database ----------------
# Prisma reads this through prisma.config.ts, which imports "dotenv/config".
DATABASE_URL="your_database_url"

# ---------------- Auth ----------------
BCRYPT_SALT_ROUNDS=10

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ---------------- Admin (used by prisma/seed.ts) ----------------
ADMIN_NAME="FixItNow Admin"
ADMIN_EMAIL=admin@fixitnow.com
ADMIN_PASSWORD=Admin@1234

# ---------------- Stripe ----------------
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRODUCT_PRICE_ID = YOUR_PRODUCT_ID
# From `stripe listen --forward-to localhost:5000/api/payments/webhook`
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
STRIPE_CURRENCY=bdt

# ---------------- SSLCommerz (optional alternative gateway) ----------------
SSL_STORE_ID=your_store_id
SSL_STORE_PASSWORD=your_store_password
SSL_IS_LIVE=false
SSL_CURRENCY=BDT
